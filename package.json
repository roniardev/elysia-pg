{
    "name": "elysia-pg",
    "type": "module",
    "scripts": {
        "dev": "bun --watch app/index.ts",
        "start": "NODE_ENV=production bun run ./app/index.ts",
        "lint": "bun x @biomejs/biome check . && bun ./scripts/check-no-else.ts",
        "lint:fix": "bun lint --write",
        "db:generate": "bun x drizzle-kit generate",
        "db:push": "bun x drizzle-kit push",
        "db:migrate": "bun x drizzle-kit migrate",
        "db:seed": " bun ./db/seeds/index.ts",
        "db:diagram": "bun ./utils/dbml.ts && bun x dbml-renderer -i ./schema.dbml -o schema.svg",
        "db:reset": "bun ./db/reset.ts"
    },
    "dependencies": {
        "@elysiajs/bearer": "^1.4.4",
        "@elysiajs/cors": "^1.4.2",
        "@elysiajs/jwt": "^1.4.2",
        "@elysiajs/opentelemetry": "^1.4.11",
        "@elysiajs/server-timing": "^1.4.1",
        "@elysiajs/swagger": "^1.3.1",
        "@otherguy/elysia-logging": "^0.0.17",
        "@verrou/core": "^0.5.2",
        "dayjs": "^1.11.21",
        "drizzle-dbml-generator": "^0.10.0",
        "drizzle-orm": "^0.45.2",
        "effect": "^3.22.1",
        "elysia": "^1.4.29",
        "elysia-autoload": "^1.7.0",
        "elysia-compress": "^1.2.1",
        "elysia-ip": "^1.1.1",
        "elysia-rate-limit": "^4.6.2",
        "env-var": "^7.5.0",
        "inversify": "^8.2.3",
        "ioredis": "^6.0.0",
        "jose": "^6.2.9",
        "logestic": "^1.2.4",
        "postgres": "^3.4.9",
        "reflect-metadata": "^0.2.2",
        "resend": "^6.20.0",
        "ulid": "^3.0.2",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.8",
        "@faker-js/faker": "^10.6.0",
        "@softwaretechnik/dbml-renderer": "^1.0.31",
        "@types/bun": "^1.3.14",
        "drizzle-kit": "^0.31.10",
        "typescript": "^7.0.2"
    },
    "version": "0.1.5"
}

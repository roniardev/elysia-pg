{
    "name": "elysia-pg",
    "type": "module",
    "scripts": {
        "dev": "bun --watch app/index.ts",
        "start": "NODE_ENV=production bun run ./app/index.ts",
        "typecheck": "tsc --noEmit",
        "test:unit": "bun test test/unit",
        "check": "bun run typecheck && bun run lint && bun run test:unit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "db:generate": "bun x drizzle-kit generate",
        "db:push": "bun x drizzle-kit push",
        "db:migrate": "bun x drizzle-kit migrate",
        "db:seed": "bun ./db/seeds/index.ts",
        "db:diagram": "bun ./utils/dbml.ts && bun x dbml-renderer -i ./schema.dbml -o schema.svg",
        "db:reset": "bun ./db/reset.ts"
    },
    "dependencies": {
        "@elysia/bearer": "2.0.0-beta.1",
        "@elysia/cors": "2.0.0-beta.1",
        "@elysia/jwt": "2.0.0-beta.1",
        "@elysia/openapi": "2.0.0-beta.4",
        "@elysia/opentelemetry": "2.0.0-beta.1",
        "@elysia/server-timing": "2.0.0-beta.1",
        "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
        "@opentelemetry/sdk-trace-node": "^2.11.0",
        "@scalar/types": "^0.18.0",
        "@verrou/core": "^0.5.2",
        "dayjs": "^1.11.21",
        "drizzle-dbml-generator": "^0.10.0",
        "drizzle-orm": "^0.45.2",
        "effect": "^3.22.1",
        "elysia": "2.0.0-beta.14",
        "elysia-compress": "^1.2.1",
        "elysia-rate-limit": "^5.1.1",
        "env-var": "^7.5.0",
        "exact-mirror": "^1.2.6",
        "ioredis": "^6.0.0",
        "jose": "^6.2.9",
        "postgres": "^3.4.9",
        "resend": "^6.20.0",
        "typebox": "^1.3.0",
        "ulid": "^3.0.2",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@faker-js/faker": "^10.6.0",
        "@softwaretechnik/dbml-renderer": "^1.0.31",
        "@stylistic/eslint-plugin": "^5.1.0",
        "@types/bun": "^1.3.14",
        "@typescript-eslint/eslint-plugin": "^8.37.0",
        "@typescript-eslint/parser": "^8.37.0",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9.0.0",
        "eslint-plugin-essential": "^1.7.0",
        "eslint-plugin-low-complexity": "^1.4.0",
        "globals": "^15.0.0",
        "typescript": "^5.8.3"
    },
    "overrides": {
        "@grpc/grpc-js": "1.14.4",
        "@opentelemetry/core": "2.11.0",
        "@opentelemetry/exporter-prometheus": "0.222.0",
        "@opentelemetry/instrumentation": "0.222.0",
        "@opentelemetry/propagator-jaeger": "2.11.0",
        "@opentelemetry/sdk-node": "0.222.0",
        "@protobufjs/utf8": "1.1.2",
        "js-yaml": "4.3.2",
        "protobufjs": "7.6.6"
    },
    "version": "0.1.6"
}
